@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@inject ITaskService TaskService
@inject IUserService UserService

<PageTitle>Admin</PageTitle>

<MudText Typo="Typo.h4" Align="Align.Center" Class="mt-5 fw-bold">Task List</MudText>

<AuthorizeView>
    <MudButton Href="/tasks/admin/create"
               Variant="Variant.Filled"
               Class="ma-3"
               Color="Color.Primary">Create New Task</MudButton>
</AuthorizeView>

@if (tasks == null)
{
    <MudText Typo="Typo.h6">There is no task</MudText>
}
else
{
    <MudTable Items="@tasks" Loading="@lodaing" LoadingProgressColor="Color.Info" Bordered="true">
        <HeaderContent>
            <MudTh Class="fw-bold">Title</MudTh>
            <MudTh Class="fw-bold">Description</MudTh>
            <MudTh Class="fw-bold">Status</MudTh>
            <MudTh Class="fw-bold">Action</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Status">@context.Status</MudTd>
            <MudTd>
                <MudButton Href="@($"tasks/edit/{context.Id}")"
                           Variant="Variant.Filled"
                           Color="Color.Secondary"
                           IconClass="@Icons.Material.Filled.Edit">Edit</MudButton>
                <MudButton onclick="@(() => HandleDeleteTask(context.Id))"
                           Variant="Variant.Filled"
                           Color="Color.Error"
                           IconClass="@Icons.Material.Filled.Delete">Delete</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}


@code {
    List<AdminTaskDto> tasks = new();
    bool lodaing;

    protected override async Task OnInitializedAsync()
    {
        tasks = await TaskService.GetAllAdminTasks();
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetAllAdminTasks();
    }

    private async Task HandleDeleteTask(int id)
    {
        var success = await TaskService.DeleteTask(id);
        if (success)
        {
            await LoadTasks();
        }
    }
}
